<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <!--
    Export-Vertrag bartbetr.xml (adebisKITA 7.5, BARTBETR.DBF aus ct240-Schema-Dump).
    Beitragssätze pro Beitragsart (BARTNR) und Gültigkeitszeitraum; BETRAGZ1..13 =
    Betrag je Buchungszeitkategorie („Staffeltabelle Beitragsart × Zeitkategorie").
    Capakita mappt BETRAGZn → ZEITKAT-Zone (adebisFeeCatalog.js) in die
    groupFeeCatalogs-Bänder. Logik/Kennzahlen: BETRAGZ3 gehört zur historischen
    Zone '03', die im 7.5-Katalog nicht mehr existiert und übersprungen wird.
  -->
  <xs:element name="BARTBETRAEGE">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="BEITRAGSSATZ" maxOccurs="unbounded" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element type="xs:short" name="IDNR"/>
              <xs:element type="xs:short" name="BARTNR"/>
              <xs:element type="xs:int" name="BBPARENT" minOccurs="0"/>
              <xs:element type="xs:string" name="SUBTYP" minOccurs="0"/>
              <xs:element type="xs:string" name="GUELTIGVON"/>
              <xs:element type="xs:string" name="GUELTIGBIS" minOccurs="0"/>
              <xs:element type="xs:string" name="BETRAG" minOccurs="0"/>
              <xs:element type="xs:string" name="BETRAGZ1" minOccurs="0"/>
              <xs:element type="xs:string" name="BETRAGZ2" minOccurs="0"/>
              <xs:element type="xs:string" name="BETRAGZ3" minOccurs="0"/>
              <xs:element type="xs:string" name="BETRAGZ4" minOccurs="0"/>
              <xs:element type="xs:string" name="BETRAGZ5" minOccurs="0"/>
              <xs:element type="xs:string" name="BETRAGZ6" minOccurs="0"/>
              <xs:element type="xs:string" name="BETRAGZ7" minOccurs="0"/>
              <xs:element type="xs:string" name="BETRAGZ8" minOccurs="0"/>
              <xs:element type="xs:string" name="BETRAGZ9" minOccurs="0"/>
              <xs:element type="xs:string" name="BETRAGZ10" minOccurs="0"/>
              <xs:element type="xs:string" name="BETRAGZ11" minOccurs="0"/>
              <xs:element type="xs:string" name="BETRAGZ12" minOccurs="0"/>
              <xs:element type="xs:string" name="BETRAGZ13" minOccurs="0"/>
              <xs:element type="xs:byte" name="MNR"/>
              <xs:element type="xs:string" name="ANLDAT"/>
              <xs:element type="xs:string" name="AENDAT"/>
              <xs:element type="xs:byte" name="ANLUSER" minOccurs="0"/>
              <xs:element type="xs:byte" name="AENUSER" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
