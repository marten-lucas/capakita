# Public HTTPS address of this CapaKita deployment (no trailing slash)
APP_ORIGIN=https://capakita.example.org

# Generate a unique random value with at least 32 characters
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Authentik: provider issuer URL, client credentials, and exact group claim value
AUTHENTIK_ISSUER_URL=https://authentik.example.org/application/o/capakita/
AUTHENTIK_CLIENT_ID=replace-with-authentik-client-id
AUTHENTIK_CLIENT_SECRET=replace-with-authentik-client-secret
AUTHENTIK_ALLOWED_GROUP=capakita-users
AUTHENTIK_GROUPS_CLAIM=groups
# Must match the scopes configured in Authentik; use a custom `groups` scope if needed
AUTHENTIK_SCOPES=openid profile email groups
# Optional; members of this group receive admin role
AUTHENTIK_ADMIN_GROUP=capakita-admins

# Keep false unless storage of non-anonymized personal data has been explicitly approved
ALLOW_UNANONYMIZED_IMPORTS=false
MAX_API_BODY_BYTES=26214400
